# ---------------------------------------------------------------------------
# Copy to .env (or just run ./install.sh, which writes this file for you).
# Values here have no "$" so they are safe for Docker Compose interpolation.
# ---------------------------------------------------------------------------

# ---- third-party API: OpenRouter (Anthropic-compatible) ----
# Create a key at https://openrouter.ai/keys - it starts with "sk-or-".
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic-compatible base URL. Do NOT append /v1.
ANTHROPIC_BASE_URL=https://openrouter.ai/api

# Optional: pin which model Claude Code uses for each role.
# Use OpenRouter "vendor/model" ids. Leave blank to use Claude Code defaults.
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=

# ---- access / hosting ----
# Your domain, e.g. code.example.com. Leave blank to serve on port 80 (HTTP).
# install.sh uses this to generate caddy/Caddyfile (a real domain enables HTTPS).
DOMAIN=

# Host directory mounted into the container as the agent's workspace.
WORKSPACE_DIR=./workspace

# Ports published by Caddy.
HTTP_PORT=80
HTTPS_PORT=443

# Optional: password for the /admin provider-switcher page. Blank = no password.
ADMIN_PASSWORD=
