# Auto-generated by install.sh - do not edit by hand.
# The site address below is either a domain (automatic HTTPS via Let's Encrypt)
# or ":80" for plain HTTP when no domain is configured.
__SITE_ADDRESS__ {
	encode zstd gzip

	# Gate the whole app behind HTTP basic auth.
	# (CloudCLI additionally asks you to set its own password on first visit.)
	basic_auth {
		__AUTH_USER__ __AUTH_HASH__
	}

	# CloudCLI web UI + WebSockets.
	reverse_proxy claude-web:3001 {
		flush_interval -1
	}
}
